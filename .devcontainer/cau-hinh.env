# Cấu hình môi trường Codespaces CT428 — giảng viên sửa MỘT LẦN rồi commit.
#
# LAB_IMAGE: image bigdata-lab đã build sẵn trên GitHub Container Registry.
#   Có giá trị  → codespace tải image này (~2 phút), không phải build.
#   Để trống    → codespace tự build từ Dockerfile (tải ~1,5 GB Hadoop/Spark/HBase, khoảng 10 phút).
#   Ví dụ: LAB_IMAGE=ghcr.io/ten-to-chuc/bigdata-lab:2026.10   (chữ thường)
LAB_IMAGE=ghcr.io/tttquyen/bigdata-lab:2026.10

# AUTO_START: cụm tự khởi động khi mở codespace?  core = cụm lõi 8 container | none = không tự bật
AUTO_START=core

# DATA_ROWS: số dòng giao dịch khi sinh dữ liệu mẫu lần đầu (200000 ≈ 20 MB; 5000000 ≈ 500 MB).
DATA_ROWS=200000

# PULL_EXTRAS: 1 = tải sẵn image Hive/Kafka/MongoDB/PostgreSQL khi tạo codespace (thêm ~6,5 GB đĩa),
#              0 = chỉ tải khi sinh viên bật dịch vụ bổ sung lần đầu.
PULL_EXTRAS=0
